graph TB
    subgraph PresentationLayer["🎨 Presentation Layer"]
        SharePriceView["SharePriceView<br/>Display single stock chart"]
        ComparisonView["ComparisonView<br/>Compare 2 stocks"]
        InputController["InputController<br/>Validate user input"]
    end

    subgraph ServiceLayer["⚙️ Service Layer"]
        IStockPriceService["IStockPriceService<br/><<Interface>>"]
        StockPriceServiceImpl["StockPriceServiceImpl<br/>Orchestration & caching"]
        IComparisonService["IComparisonService<br/><<Interface>>"]
        ComparisonServiceImpl["ComparisonServiceImpl<br/>Compare stocks"]
        NetworkService["NetworkService<br/>Connectivity detection"]
    end

    subgraph RepositoryLayer["💾 Repository Layer"]
        IStockRepository["IStockRepository<br/><<Interface>>"]
        SQLiteRepository["SQLiteRepository<br/>SQLite implementation"]
        JSONRepository["JSONRepository<br/>JSON file storage"]
        MockRepository["MockStockRepository<br/>Sprint 1 mock"]
        
        IExternalDataSource["IExternalDataSource<br/><<Interface>>"]
        YahooAPI["YahooFinanceAPIClient<br/>Yahoo Finance integration"]
        MockDataSource["MockExternalDataSource<br/>Sprint 1 mock"]
        
        DataMapper["DataMapper<br/>API to Domain mapping"]
    end

    subgraph DomainModelLayer["📦 Domain Model Layer"]
        StockPrice["StockPrice<br/>Stock price entity"]
        DateRange["DateRange<br/>Date range value object"]
        Symbol["Symbol<br/>Stock symbol"]
        PriceData["PriceData<br/>OHLCV data"]
    end

    subgraph ArchitectureLayer["🏗️ Architecture Patterns"]
        RepositoryFactory["RepositoryFactory<br/>Factory Pattern"]
    end

    %% Presentation to Service
    SharePriceView --> IStockPriceService
    ComparisonView --> IComparisonService
    InputController --> StockPrice
    InputController --> DateRange

    %% Service Layer
    IStockPriceService -.implements.-> StockPriceServiceImpl
    IComparisonService -.implements.-> ComparisonServiceImpl
    StockPriceServiceImpl --> IStockRepository
    StockPriceServiceImpl --> IExternalDataSource
    ComparisonServiceImpl --> IStockPriceService

    %% Repository Layer
    IStockRepository -.implements.-> SQLiteRepository
    IStockRepository -.implements.-> JSONRepository
    IStockRepository -.implements.-> MockRepository
    IExternalDataSource -.implements.-> YahooAPI
    IExternalDataSource -.implements.-> MockDataSource
    
    %% Factory
    RepositoryFactory --> IStockRepository
    
    %% Repository to Domain
    SQLiteRepository --> StockPrice
    JSONRepository --> StockPrice
    MockRepository --> StockPrice
    YahooAPI --> DataMapper
    MockDataSource --> StockPrice
    DataMapper --> StockPrice

    %% Service to Domain
    StockPriceServiceImpl --> StockPrice
    StockPriceServiceImpl --> DateRange

